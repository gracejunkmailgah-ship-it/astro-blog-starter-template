---
import Layout from '../layouts/BlogPost.astro';
import NavBar from '../components/Navigation.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_PHONE } from '../consts';
import '../styles/style.css';
---
<NavBar />

<body>

  <div class="emergency-bar">
    ⚠ Emergency Tree Service Available Across Portland & Southern Maine
  </div>

  <header class="hero">
    <div class="container hero-content">

      <div>
        <div class="eyebrow">
          ISA Certified Arborist • TRAQ Qualified • Fully Insured
        </div>

  <!-- HERO -->
  <section class="hero">

    <div class="container">

      <div style="max-width: 760px; padding: 80px 0; position: relative; z-index: 2;">

        <div class="eyebrow">
          About Sam Books
        </div>

        <h1>
          Professional Tree Care From An ISA Certified Arborist
        </h1>

        <p>
          By the Books is an owner-operated tree care company focused on
          safe, ethical, and science-based arboriculture. We provide expert
          guidance and hands-on care to help clients protect the health,
          structure, and long-term value of their trees. 
        </p>

      </div>

    </div>

  </section>

  <!-- ABOUT SECTION -->
  <section>

    <div class="container">

      <div class="about-box">

        <!-- LEFT SIDE -->
        <div>

          <div class="section-heading">

            <span>Who We Are</span>

            <h2>
              Experienced Arboriculture With A Personal Approach
            </h2>

            <p>
              As an owner-operated business, every project receives direct
              attention from a certified professional committed to quality,
              communication, and safety. We believe proper tree care should
              balance risk management, preservation, and long-term tree health.
            </p>

          </div>

          <div class="quote-box">

            <p>
              “Our goal is to provide
              <strong>honest recommendations and professional tree care</strong>
              that homeowners can trust.”
            </p>

          </div>

        </div>

        <!-- RIGHT SIDE -->
        <div>

          <ul class="check-list">

            <li>
              <div class="check">✓</div>

              <div>
                <strong>ISA TRAQ Certified Arborist</strong><br />
                Certified in Tree Risk Assessment and professional arboriculture standards.
              </div>
            </li>

            <li>
              <div class="check">✓</div>

              <div>
                <strong>Owner-Operated</strong><br />
                Direct communication and hands-on project management from start to finish.
              </div>
            </li>

            <li>
              <div class="check">✓</div>

              <div>
                <strong>Safety Focused</strong><br />
                Modern climbing, rigging, and work practices designed to protect people and property.
              </div>
            </li>

            <li>
              <div class="check">✓</div>

              <div>
                <strong>Tree Preservation Mindset</strong><br />
                Recommendations centered around tree health, structure, and sustainability.
              </div>
            </li>

          </ul>

        </div>

      </div>

    </div>

  </section>

  <!-- VALUES SECTION -->
  <section>

    <div class="container">

      <div class="section-heading">

        <span>Our Approach</span>

        <h2>
          Built On Knowledge, Integrity, And Professionalism
        </h2>

        <p>
          We believe tree care should be thoughtful, transparent, and rooted in
          modern arboriculture practices.
        </p>

      </div>

      <div class="services-grid">

        <div class="service-card">

          <div class="service-icon">🌳</div>

          <h3>Tree Health First</h3>

          <p>
            We prioritize long-term tree vitality and structural integrity whenever possible.
          </p>

        </div>

        <div class="service-card">

          <div class="service-icon">🛡️</div>

          <h3>Risk Management</h3>

          <p>
            Careful assessment and professional planning help reduce hazards and protect property.
          </p>

        </div>

        <div class="service-card">

          <div class="service-icon">🤝</div>

          <h3>Honest Communication</h3>

          <p>
            Clear recommendations, transparent pricing, and dependable service on every project.
          </p>

        </div>

      </div>

    </div>

  </section>

  <!-- CTA -->
  <section class="cta">

    <div class="container">

      <h2>
        Need Professional Arborist Services?
      </h2>

      <p>
        Contact By the Books Tree Care today for expert tree care and consultations.
      </p>

      <a href="tel:+12075551234" class="btn btn-primary">
        Call Now
      </a>

    </div>

  </section>

  <!-- FOOTER -->
  <footer>
    © 2026 By the Books Tree Care. All rights reserved.
  </footer>

</body>
</html>
