---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>ISA Certified Arborist Portland Maine | By the Books Tree Care</title>

  <meta
    name="description"
    content="ISA Certified Arborist serving Portland, Maine. Professional tree pruning, removals, storm cleanup, and TRAQ tree risk assessments."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <style>
    :root {
      --green: #0f3d2e;
      --green-light: #14532d;
      --accent: #22c55e;
      --cream: #f7f8f5;
      --text: #1f2937;
      --muted: #6b7280;
      --white: #ffffff;
      --border: rgba(255,255,255,0.08);
      --shadow: 0 20px 50px rgba(0,0,0,0.08);
      --radius: 20px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, system-ui, sans-serif;
      color: var(--text);
      background: #f3f5f4;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* TOP BAR */

    .emergency-bar {
      background: #111827;
      color: white;
      text-align: center;
      padding: 10px 20px;
      font-size: 0.95rem;
      letter-spacing: 0.2px;
    }

    /* HERO */

    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at top left, rgba(34,197,94,0.15), transparent 35%),
        linear-gradient(135deg, #0b2f23, #14532d 60%, #1c6b45);
      color: white;
      min-height: 92vh;
      display: flex;
      align-items: center;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.35));
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 60px;
      align-items: center;
      padding: 80px 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255,255,255,0.08);
      border: 1px solid var(--border);
      padding: 10px 16px;
      border-radius: 999px;
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
      font-size: 0.92rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 0.95;
      letter-spacing: -3px;
      margin-bottom: 24px;
      max-width: 700px;
    }

    .hero p {
      font-size: 1.15rem;
      max-width: 650px;
      color: rgba(255,255,255,0.82);
      margin-bottom: 32px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 40px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 15px 24px;
      border-radius: 14px;
      font-weight: 600;
      transition: 0.25s ease;
    }

    .btn-primary {
      background: white;
      color: var(--green);
      box-shadow: var(--shadow);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
    }

    .btn-secondary {
      border: 1px solid rgba(255,255,255,0.2);
      color: white;
      background: rgba(255,255,255,0.06);
      backdrop-filter: blur(10px);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .stat-card {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.08);
      backdrop-filter: blur(12px);
      border-radius: var(--radius);
      padding: 26px;
    }

    .stat-card h3 {
      font-size: 2rem;
      margin-bottom: 6px;
    }

    .stat-card p {
      margin: 0;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.75);
    }

    /* SECTION */

    section {
      padding: 90px 0;
    }

    .section-heading {
      margin-bottom: 50px;
    }

    .section-heading span {
      color: var(--accent);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 0.8rem;
    }

    .section-heading h2 {
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1.05;
      margin-top: 10px;
      color: #111827;
      letter-spacing: -1.5px;
    }

    .section-heading p {
      color: var(--muted);
      max-width: 700px;
      margin-top: 16px;
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
    }

    .service-card {
      background: white;
      padding: 30px;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      transition: 0.25s ease;
    }

    .service-card:hover {
      transform: translateY(-6px);
    }

    .service-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: #dcfce7;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 1.5rem;
    }

    .service-card h3 {
      margin-bottom: 12px;
      color: #111827;
    }

    .service-card p {
      color: var(--muted);
    }

    /* ABOUT */

    .about-box {
      background: linear-gradient(135deg, #ffffff, #f8faf8);
      border-radius: 28px;
      padding: 50px;
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .check-list {
      list-style: none;
      display: grid;
      gap: 18px;
    }

    .check-list li {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      color: #374151;
    }

    .check {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #dcfce7;
      color: var(--green);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.85rem;
      font-weight: bold;
    }

    /* QUOTE */

    .quote-box {
      margin-top: 30px;
      padding: 28px;
      background: #0f172a;
      color: white;
      border-radius: var(--radius);
    }

    .quote-box strong {
      color: #86efac;
    }

    /* CONTACT */

    .contact-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 32px;
    }

    .contact-card,
    .form-card {
      background: white;
      border-radius: var(--radius);
      padding: 36px;
      box-shadow: var(--shadow);
    }

    .contact-card h3,
    .form-card h3 {
      margin-bottom: 18px;
      font-size: 1.5rem;
    }

    .contact-card p {
      color: var(--muted);
      margin-bottom: 18px;
    }

    .contact-info {
      display: grid;
      gap: 18px;
      margin-top: 24px;
    }

    .contact-item {
      padding: 18px;
      border-radius: 16px;
      background: #f9fafb;
    }

    form {
      display: grid;
      gap: 16px;
    }

    input,
    textarea {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #d1d5db;
      background: #f9fafb;
      font-size: 1rem;
      transition: 0.2s ease;
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
      background: white;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    button {
      border: none;
      cursor: pointer;
      font-size: 1rem;
    }

    .submit-btn {
      background: var(--green);
      color: white;
      padding: 16px;
      border-radius: 14px;
      font-weight: 600;
      transition: 0.25s ease;
    }

    .submit-btn:hover {
      background: #0d3326;
    }

    /* CTA */

    .cta {
      padding: 90px 20px;
      text-align: center;
      background:
        linear-gradient(135deg, #0f3d2e, #14532d);
      color: white;
    }

    .cta h2 {
      font-size: clamp(2rem, 5vw, 3.4rem);
      margin-bottom: 18px;
      letter-spacing: -1.5px;
    }

    .cta p {
      color: rgba(255,255,255,0.8);
      margin-bottom: 30px;
      font-size: 1.1rem;
    }

    /* FOOTER */

    footer {
      background: #111827;
      color: rgba(255,255,255,0.75);
      padding: 40px 20px;
      text-align: center;
      font-size: 0.95rem;
    }

    /* STICKY */

    .sticky-call {
      position: fixed;
      right: 18px;
      bottom: 18px;
      background: var(--green);
      color: white;
      padding: 16px 22px;
      border-radius: 999px;
      font-weight: 700;
      box-shadow: 0 12px 30px rgba(0,0,0,0.2);
      z-index: 999;
      transition: 0.25s ease;
    }

    .sticky-call:hover {
      transform: translateY(-3px);
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {

      .hero-content,
      .about-box,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: auto;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .hero-stats {
        grid-template-columns: 1fr 1fr;
      }

      .about-box {
        padding: 36px;
      }
    }

    @media (max-width: 640px) {

      .hero {
        padding-top: 40px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

      .hero-stats {
        grid-template-columns: 1fr;
      }

      section {
        padding: 70px 0;
      }
    }
  </style>
</head>

<body>

  <div class="emergency-bar">
    ⚠ Emergency Tree Service Available Across Portland & Southern Maine
  </div>

  <header class="hero">
    <div class="container hero-content">

      <div>
        <div class="eyebrow">
          ISA Certified Arborist • TRAQ Qualified • Fully Insured
        </div>

        <h1>
          Modern Tree Care Rooted in Safety & Integrity
        </h1>

        <p>
          By the Books Tree Care provides professional pruning, removals,
          storm cleanup, and science-based tree preservation throughout
          Portland and Southern Maine.
        </p>

        <div class="hero-buttons">
          <a href="tel:+19708197459" class="btn btn-primary">
            Call Now
          </a>

          <a href="#contact" class="btn btn-secondary">
            Request Free Estimate
          </a>
        </div>
      </div>

      <div class="hero-stats">

        <div class="stat-card">
          <h3>ISA</h3>
          <p>Certified Arborist Standards & Best Practices</p>
        </div>

        <div class="stat-card">
          <h3>TRAQ</h3>
          <p>Qualified Tree Risk Assessments</p>
        </div>

        <div class="stat-card">
          <h3>100%</h3>
          <p>Owner Operated & Fully Insured</p>
        </div>

        <div class="stat-card">
          <h3>Local</h3>
          <p>Serving Portland & Southern Maine</p>
        </div>

      </div>

    </div>
  </header>

  <!-- SERVICES -->

  <section>
    <div class="container">

      <div class="section-heading">
        <span>Services</span>
        <h2>Professional Arborist Services</h2>
        <p>
          Science-based tree care focused on long-term health,
          structural integrity, and property safety.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon">🌲</div>
          <h3>Tree Pruning</h3>
          <p>
            Improve structure, health, appearance, and storm resistance.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">🪵</div>
          <h3>Tree Removal</h3>
          <p>
            Safe removal of hazardous, damaged, or unwanted trees.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">📋</div>
          <h3>Risk Assessments</h3>
          <p>
            TRAQ-certified evaluations for hazardous tree conditions.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">⛈</div>
          <h3>Storm Cleanup</h3>
          <p>
            Emergency response and cleanup after severe weather events.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">🌿</div>
          <h3>Tree Preservation</h3>
          <p>
            Honest recommendations focused on saving healthy trees.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ABOUT -->

  <section>
    <div class="container">

      <div class="about-box">

        <div>
          <div class="section-heading">
            <span>Why Choose Me</span>
            <h2>Expert Tree Care Without the Sales Pressure</h2>
          </div>

          <p style="color:#6b7280;">
            Every project is approached with a safety-first mindset,
            modern arboriculture standards, and honest recommendations
            based on what is best for the tree and property owner.
          </p>

          <div class="quote-box">
            <strong>Honest Tree Evaluations:</strong><br><br>
            I focus on preserving healthy trees whenever possible and only
            recommend removal when necessary for safety or structural concerns.
          </div>
        </div>

        <div>
          <ul class="check-list">

            <li>
              <span class="check">✓</span>
              ISA Certified Arborist training & standards
            </li>

            <li>
              <span class="check">✓</span>
              TRAQ qualified tree risk assessments
            </li>

            <li>
              <span class="check">✓</span>
              Owner performs or supervises every job
            </li>

            <li>
              <span class="check">✓</span>
              No unnecessary removals or upselling
            </li>

            <li>
              <span class="check">✓</span>
              Safety-focused work practices
            </li>

            <li>
              <span class="check">✓</span>
              Local experience with Maine tree species & weather
            </li>

          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- CONTACT -->

  <section id="contact">
    <div class="container">

      <div class="section-heading">
        <span>Free Estimate</span>
        <h2>Request Tree Care Services</h2>
        <p>
          Fast response times, honest evaluations, and professional arborist guidance.
        </p>
      </div>

      <div class="contact-grid">

        <div class="contact-card">
          <h3>Serving Southern Maine</h3>

          <p>
            Portland, South Portland, Westbrook, Falmouth,
            Cape Elizabeth, and surrounding communities.
          </p>

          <div class="contact-info">

            <div class="contact-item">
              <strong>Phone</strong><br>
              <a href="tel:+19708197459">(970) 819-7459</a>
            </div>

            <div class="contact-item">
              <strong>Services</strong><br>
              Pruning • Removals • Risk Assessments • Storm Cleanup
            </div>

            <div class="contact-item">
              <strong>Availability</strong><br>
              Emergency tree service available
            </div>

          </div>
        </div>

        <div class="form-card">
          <h3>Request a Free Estimate</h3>

          <form action="https://formspree.io/f/YOUR_ID" method="POST">

            <input
              type="text"
              name="name"
              placeholder="Your Name"
              required
            />

            <input
              type="email"
              name="email"
              placeholder="Your Email"
              required
            />

            <input
              type="text"
              name="city"
              placeholder="Your City"
            />

            <textarea
              name="message"
              placeholder="Tell me about your tree project..."
              required
            ></textarea>

            <button type="submit" class="submit-btn">
              Send Request
            </button>

          </form>
        </div>

      </div>

    </div>
  </section>

  <!-- CTA -->

  <section class="cta">
    <h2>Need a Certified Arborist in Portland?</h2>

    <p>
      Fast response. Honest advice. Professional tree care.
    </p>

    <a href="tel:+19708197459" class="btn btn-primary">
      Call Now
    </a>
  </section>

  <!-- FOOTER -->

  <footer>
    <p>
      By the Books Tree Care • ISA Certified Arborist • Portland, Maine
    </p>

    <p style="margin-top:10px;">
      Fully Insured • Owner Operated • Professional Tree Care
    </p>
  </footer>

  <!-- STICKY CALL BUTTON -->

  <a href="tel:+19708197459" class="sticky-call">
    📞 Call Now
  </a>

</body>
</html>

