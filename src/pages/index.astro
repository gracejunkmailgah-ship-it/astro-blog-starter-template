---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>ISA Certified Arborist Portland Maine | Tree Care & Risk Assessment</title>
  <meta name="description" content="ISA Certified Arborist serving Portland, Maine. Tree pruning, removal, and TRAQ risk assessments. Owner-operated, insured, professional tree care." />

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #1f2937;
      background: #ffffff;
      line-height: 1.6;
    }

    header {
      background: linear-gradient(135deg, #14532d, #166534);
      color: white;
      padding: 70px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 2.2rem;
      margin-bottom: 10px;
    }

    header p {
      max-width: 750px;
      margin: auto;
      font-size: 1.1rem;
    }

    .badges {
      margin-top: 15px;
      font-weight: bold;
      font-size: 0.95rem;
    }

    .buttons {
      margin-top: 20px;
    }

    .buttons a {
      display: inline-block;
      margin: 8px;
      padding: 12px 18px;
      background: white;
      color: #14532d;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
    }

    .emergency {
      background: #dc2626;
      color: white;
      text-align: center;
      padding: 12px;
      font-weight: bold;
    }

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 40px 20px;
    }

    h2 {
      color: #14532d;
      margin-bottom: 10px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
    }

    .card {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 15px;
      background: #f9fafb;
    }

    .highlight {
      background: #f0fdf4;
      border-left: 5px solid #14532d;
      padding: 15px;
      margin: 20px 0;
    }

    ul {
      padding-left: 20px;
    }

    form {
      display: grid;
      gap: 10px;
      margin-top: 15px;
    }

    input, textarea {
      padding: 10px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 1rem;
    }

    button {
      background: #14532d;
      color: white;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }

    .cta {
      background: #14532d;
      color: white;
      text-align: center;
      padding: 50px 20px;
      margin-top: 40px;
    }

    .cta a {
      background: white;
      color: #14532d;
      padding: 12px 18px;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
      display: inline-block;
      margin-top: 10px;
    }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 0.9rem;
      background: #f3f4f6;
      margin-top: 40px;
    }

    .sticky-call {
      position: fixed;
      bottom: 15px;
      right: 15px;
      background: #14532d;
      color: white;
      padding: 14px 18px;
      border-radius: 50px;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
      z-index: 999;
    }
  </style>
</head>

<body>

<div class="emergency">
  ⚠️ Emergency Tree Service Available in Portland, Maine & Surrounding Areas
</div>

<header>
  <h1>By the Books Tree Care</h1>
  <p>
   ISA Certified Arborist serving homeowners across Southern Maine. Professional tree care focused on safety, health, and long-term preservation of Maine's trees. Owner-operated, insured, professional tree care.
  </p>

  <div class="badges">
    ISA Certified Arborist • TRAQ Qualified • Fully Insured • Owner Operated
  </div>

  <div class="buttons">
    <a href="tel:+1 970 819 7459">Call Now</a>
    <a href="#contact">Request Free Estimate</a>
  </div>
</header>

<div class="container">

  <div class="highlight">
    ISA Certified Arborist providing science-based tree care in Portland, South Portland,
    Westbrook, Falmouth, Cape Elizabeth, and surrounding areas.
  </div>

  <h2>Tree Care Services</h2>
  <div class="grid">
    <div class="card">
      <h3>Tree Pruning</h3>
      <p>Improve structure, safety, and long-term tree health.</p>
    </div>

    <div class="card">
      <h3>Tree Removal</h3>
      <p>Safe removal of hazardous or unwanted trees.</p>
    </div>

    <div class="card">
      <h3>Tree Risk Assessment</h3>
      <p>TRAQ-certified evaluations for hazardous trees.</p>
    </div>

    <div class="card">
      <h3>Storm Cleanup</h3>
      <p>Emergency response after wind or storm damage.</p>
    </div>

    <div class="card">
      <h3>Tree Preservation</h3>
      <p>Focus on saving and improving valuable trees when possible.</p>
    </div>
  </div>

  <h2 style="margin-top:40px;">Why Choose Me</h2>
  <ul>
    <li>ISA Certified Arborist training and standards</li>
    <li>TRAQ qualified tree risk assessment</li>
    <li>Owner performs or supervises every job</li>
    <li>Honest recommendations — no unnecessary removals</li>
    <li>Safety-first approach to all work</li>
    <li>Local knowledge of Maine trees and weather</li>
  </ul>

  <div class="highlight">
    <strong>Honest Tree Evaluations:</strong>
    I focus on preserving healthy trees whenever possible and only recommend removal when necessary for safety.
  </div>

  <h2>Recent Work</h2>
  <div class="grid">
    <div class="card">
      <h3>Pruning & Structure Improvement</h3>
      <p>Reduced storm risk and improved tree health.</p>
    </div>

    <div class="card">
      <h3>Hazard Tree Removal</h3>
      <p>Safe removal of high-risk tree near residential property.</p>
    </div>

    <div class="card">
      <h3>Tree Risk Assessment</h3>
      <p>TRAQ evaluation for long-term property safety planning.</p>
    </div>
  </div>

  <h2 style="margin-top:40px;">Request a Free Estimate</h2>

  <form action="https://formspree.io/f/YOUR_ID" method="POST">
    <input type="text" name="name" placeholder="Your Name" required />
    <input type="email" name="email" placeholder="Your Email" required />
    <input type="text" name="city" placeholder="City" />
    <textarea name="message" rows="4" placeholder="What do you need help with?" required></textarea>
    <button type="submit">Send Request</button>
  </form>

</div>

<div class="cta">
  <h2>Need a Certified Arborist in Portland?</h2>
  <p>Fast response. Honest advice. No pressure.</p>
  <a href="tel:+1YOURNUMBER">Call Now</a>
</div>

<footer>
  By the Books Tree Care <p>ISA Certified Arborist • Portland Maine Tree Care • Fully Insured • Owner Operated</p>
</footer>

<a href="tel:+1 970 819 7459" class="sticky-call">Call Now</a>

</body>
</html>

