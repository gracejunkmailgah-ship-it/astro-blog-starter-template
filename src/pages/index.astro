---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_PHONE } from '../consts';
import '../styles/style.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>ISA Certified Arborist Portland Maine | By the Books Tree Care</title>

  <meta
    name="description"
    content="ISA Certified Arborist serving Portland, Maine. Professional tree pruning, tree removals, stump grinding, storm cleanup, and TRAQ tree risk assessments."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="styles.css">
</head>
<header class="site-header">
  <div class="container navbar">

    <!-- SITE TITLE -->
    <a href="index.html" class="site-title">
      Evergreen Landscaping
    </a>

    <!-- NAVIGATION -->
    <nav class="nav-links">
      <a href="index">Home</a>
      <a href="about">About</a>
      <a href="services">Services</a>
      <a href="photos">Photos</a>
      <!-- CALL BUTTON -->
      <a href="tel:+19708197459" class="nav-call-btn">
        Call Us
      </a>
    </nav>

  </div>
</header>
<body>

  <div class="emergency-bar">
    ⚠ Emergency Tree Service Available Across Portland & Southern Maine
  </div>
        <h1>
{SITE_TITLE}
        </h1>

        <p>
         Modern tree care rooted in safety & integrity. At {SITE_TITLE} we pride ourselves in providing professional tree pruning, removals, stump grinding, 
          storm cleanup, and science-based tree preservation for homeowners throughout Portland and Southern Maine.
        </p>

        <div class="hero-buttons">
          <a href="tel:+19708197459" class="btn btn-primary">
            Call Now
          </a>

          <a href="#contact" class="btn btn-secondary">
            Request Free Estimate
          </a>
        </div>
      </div>

      <div class="hero-stats">

        <div class="stat-card">
          <h3>ISA</h3>
          <p>Certified Arborist® Standards & Best Practices</p>
        </div>

        <div class="stat-card">
          <h3>ISA TRAQ</h3>
          <p>Tree Risk Assessment Qualified</p>
        </div>

        <div class="stat-card">
          <h3>100%</h3>
          <p>Owner Operated & Fully Insured</p>
        </div>

        <div class="stat-card">
          <h3>Local</h3>
          <p>Serving Portland & Southern Maine</p>
        </div>

      </div>

    </div>
  </header>

  <!-- SERVICES -->

  <section>
    <div class="container">

      <div class="section-heading">
        <span>Services</span>
        <h2>Professional Arborist Services</h2>
        <p>
          Science-based tree care focused on the long-term health, 
          structural integrity, and property safety.
        </p>
      </div>

      <div class="services-grid">

        <div class="service-card">
          <div class="service-icon">🌲</div>
          <h3>Tree Pruning</h3>
          <p>
            Improve tree structure, health, appearance, and storm resistance .
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">🪵</div>
          <h3>Tree Removal</h3>
          <p>
            Safely remove hazardous, damaged, or unwanted trees.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">📋</div>
          <h3>Risk Assessments</h3>
          <p>
            TRAQ Tree Risk Assessment Qualified evaluations for hazardous tree conditions.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">⛈</div>
          <h3>Storm Cleanup</h3>
          <p>
            Offering emergency response and cleanup after severe weather events.
          </p>
        </div>

        <div class="service-card">
          <div class="service-icon">🌿</div>
          <h3>Tree Preservation</h3>
          <p>
            Honest recommendations focused on preserving and maintaining healthy trees.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ABOUT -->

  <section>
    <div class="container">

      <div class="about-box">

        <div>
          <div class="section-heading">
            <span>Why Choose Me</span>
            <h2>Expert Tree Care Without the Sales Pressure</h2>
          </div>

          <p style="color:#6b7280;">
            Every project is approached with a safety-first mindset,
            modern arboriculture standards, and honest recommendations
            based on what is best for the tree and property owner. 
          </p>

          <div class="quote-box">
            <strong>Honest Tree Evaluations:</strong><br><br>
            I focus on preserving healthy trees whenever possible. I'll only
            recommend removal when necessary for safety or structural concerns.
          </div>
        </div>

        <div>
          <ul class="check-list">

            <li>
              <span class="check">✓</span>
              ISA Certified Arborist® training & standards
            </li>

            <li>
              <span class="check">✓</span>
              TRAQ Tree Risk Assessment Qualified tree risk assessments
            </li>

            <li>
              <span class="check">✓</span>
              Owner, Sam Books, performs or supervises every job
            </li>

            <li>
              <span class="check">✓</span>
              No unnecessary removals or upselling
            </li>

            <li>
              <span class="check">✓</span>
              Modern safety-focused work practices
            </li>

            <li>
              <span class="check">✓</span>
              Local experience with Maine tree species & weather
            </li>

          </ul>
        </div>

      </div>

    </div>
  </section>

  <!-- CONTACT -->

  <section id="contact">
    <div class="container">

      <div class="section-heading">
        <span>Free Estimate</span>
        <h2>Request Tree Care Services</h2>
        <p>
          Fast response times, honest evaluations, and professional arborist guidance.
        </p>
      </div>

      <div class="contact-grid">

        <div class="contact-card">
          <h3>Serving Southern Maine</h3>

          <p>
            Portland, South Portland, Westbrook, Falmouth, Yarmouth,
            Cape Elizabeth, and surrounding communities.
          </p>

          <div class="contact-info">

            <div class="contact-item">
              <strong>Phone</strong><br>
              <a href="tel:+19708197459">(970) 819-7459</a>
            </div>

            <div class="contact-item">
              <strong>Services</strong><br>
              Pruning • Removals • Risk Assessments • Storm Cleanup
            </div>

            <div class="contact-item">
              <strong>Availability</strong><br>
              Emergency tree service available
            </div>

          </div>
        </div>

        <div class="form-card">
          <h3>Request a Free Estimate</h3>

          <form action="https://formspree.io/f/YOUR_ID" method="POST">

            <input
              type="text"
              name="name"
              placeholder="Your Name"
              required
            />

            <input
              type="email"
              name="email"
              placeholder="Your Email"
              required
            />
             <input
              type="tel"
              name="tel"
              placeholder="Your Phone Number"
              required
            />

            <input
              type="text"
              name="city"
              placeholder="Your City"
            />

            <textarea
              name="message"
              placeholder="Tell me about your tree project..."
              required
            ></textarea>

            <button type="submit" class="submit-btn">
              Send Request
            </button>

          </form>
        </div>

      </div>

    </div>
  </section>

  <!-- CTA -->

  <section class="cta">
    <h2>Need a Certified Arborist in Portland?</h2>

    <p>
      Fast response. Honest advice. Professional tree care.
    </p>

    <a href="tel:+19708197459" class="btn btn-primary">
      Call Now
    </a>
  </section>

  <!-- FOOTER -->

  <footer>
    <p>
      By the Books Tree Care • ISA Certified Arborist • Portland, Maine
    </p>

    <p style="margin-top:10px;">
      Fully Insured • Owner Operated • Professional Tree Care
    </p>
  </footer>

  <!-- STICKY CALL BUTTON -->

  <a href="tel:+19708197459" class="sticky-call">
    📞 Call Now
  </a>

</body>
</html>

